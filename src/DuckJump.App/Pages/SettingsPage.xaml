<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DuckJump.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DuckJump.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="#0A0F1C">
        <StackPanel Padding="32,24,32,40" Spacing="20">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Настройки" />
            <Border Padding="24" Background="#111827" CornerRadius="18">
                <StackPanel Spacing="20">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Подключение" />
                    <ToggleSwitch Header="Запускать вместе с Windows" OffContent="Выключено" OnContent="Включено" />
                    <ToggleSwitch Header="Подключаться автоматически" IsOn="True" OffContent="Выключено" OnContent="Включено" />
                    <ToggleSwitch Header="Kill switch" IsOn="True" OffContent="Выключен" OnContent="Включён" />
                </StackPanel>
            </Border>
            <Border Padding="24" Background="#111827" CornerRadius="18">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Приватность" />
                    <ComboBox Header="DNS" SelectedIndex="0">
                        <ComboBoxItem Content="Через VPN" />
                        <ComboBoxItem Content="Системный" />
                        <ComboBoxItem Content="Пользовательский" />
                    </ComboBox>
                    <ToggleSwitch Header="Защита IPv6" IsOn="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
