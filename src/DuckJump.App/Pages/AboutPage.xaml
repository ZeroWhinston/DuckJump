<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DuckJump.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DuckJump.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32" Background="#0A0F1C">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <Border Width="96" Height="96" Background="#173A2A" CornerRadius="28">
                <FontIcon FontSize="46" Foreground="#43D17A" Glyph="&#xE83D;" />
            </Border>
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="DuckJump" />
            <TextBlock Foreground="#93A4BA" Text="Безопасный VPN-клиент для Windows и мобильных устройств" />
            <TextBlock Margin="0,8,0,0" Foreground="#66758A" Text="Версия 0.1.0 · ранний прототип" />
        </StackPanel>
    </Grid>
</Page>
